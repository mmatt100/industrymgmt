@baseUrl = http://localhost:3000

### List products
GET {{baseUrl}}/products

### Create product
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "description": "Ergonomic Bluetooth mouse",
  "price": 4999,
  "stock": 25,
  "category": "electronics"
}

### Restock product
POST {{baseUrl}}/products/1/restock
Content-Type: application/json

{
  "quantity": 10
}

### Sell product
POST {{baseUrl}}/products/1/sell
Content-Type: application/json

{
  "quantity": 2
}
